# ==============================================================================
# AURA AI — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and populate your sensitive credentials.
# NEVER commit your real '.env' file with real secrets to public repositories!

# The port where your Express backend server will listen
PORT=3000

# Google Gemini API Key (Get a free API key at: https://aistudio.google.com/)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# MongoDB Connection String (Get a free cloud database cluster at: https://cloud.mongodb.com/)
# Example: mongodb+srv://myUser:myPassword@cluster0.mongodb.net/aura_ai?retryWrites=true&w=majority
# Or local MongoDB: mongodb://localhost:27017/aura_ai
MONGODB_URI=YOUR_MONGODB_URI_HERE
